# Public origin used for trusted redirects and Stripe return URLs.
APP_URL=

# Supabase project URL exposed to browser code.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/publishable key exposed to browser code.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe server API key (prefer a least-privilege restricted key where supported).
STRIPE_SECRET_KEY=

# Stripe webhook endpoint signing secret.
STRIPE_WEBHOOK_SECRET=

# Stripe recurring Price IDs for the canonical paid tiers.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ULTIMATE=

# AI provider keys used by chat and KeeBot routes. Server-side only.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Speech-to-text service endpoint (server-side only).
WHISPER_API_URL=
WHISPER_SERVICE_TOKEN=

# ── Payments: aggregator channel (Alipay / WeChat, personal entity) ──
# off (default) keeps the existing Stripe checkout path exactly as it is and
# makes every /api/pay/* route answer 404. Switch to `aggregator` only after the
# merchant credentials below exist: the change needs a rebuild, because the
# pricing page is prerendered.
PAY_PROVIDER=off
# Keep false until a real-money provider, webhooks, and an end-to-end payment test are complete.
PAID_CHECKOUT_ENABLED=false

# Merchant gateway. Server-side only — never expose these to the browser.
PAY_AGGREGATOR_GATEWAY_URL=
PAY_AGGREGATOR_MCH_ID=
PAY_AGGREGATOR_APP_ID=
PAY_AGGREGATOR_SECRET=
# md5 | hmac-sha256 (default)
PAY_AGGREGATOR_SIGN_TYPE=hmac-sha256
# Optional overrides. Defaults: {APP_URL}/api/pay/notify and {APP_URL}/payment/success
PAY_AGGREGATOR_NOTIFY_URL=
PAY_AGGREGATOR_RETURN_URL=

# ── Free-tier advertising ──
# Everything below is inert until NEXT_PUBLIC_ADS_ENABLED=true. Ads render for
# the free tier only; paid tiers and unknown entitlement states never load an ad.
NEXT_PUBLIC_ADS_ENABLED=false
# adsense | baidu | custom
NEXT_PUBLIC_ADS_NETWORK=
# AdSense publisher id (ca-pub-…), or the network's client/slot id.
NEXT_PUBLIC_ADS_CLIENT_ID=
NEXT_PUBLIC_ADS_SLOT_RESULT=
NEXT_PUBLIC_ADS_SLOT_SIDEBAR=
# Required for baidu/custom; AdSense uses its own script URL when this is empty.
NEXT_PUBLIC_ADS_SCRIPT_URL=
# Self-served house creatives for the free tier (network=custom, no third-party
# script needed). JSON array of {id, placement: result|sidebar, title, body,
# href, cta}. Leave empty to disable house ads entirely.
NEXT_PUBLIC_ADS_HOUSE_JSON=
